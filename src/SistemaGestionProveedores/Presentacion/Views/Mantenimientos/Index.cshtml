@using Presentacion.Models.Mantenimientos
@model IEnumerable<MantenimientoViewModel>

@{
    ViewData["Title"] = "Lista de mantenimientos";
}

<h1 class="mb-4">Mantenimientos realizados</h1>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Mantenimiento
    </a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Número de Serie</th>
                <th>Equipo</th>
                <th>Tipo de Mantenimiento</th>
                <th>Costo</th>
                <th>Fecha</th>
                <th>Realizado por Técnico</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mantenimiento in Model)
            {
                <tr>
                    <td>@mantenimiento.NumeroSerie</td>
                    <td>@mantenimiento.Equipo</td>
                    <td>@mantenimiento.TipoMantenimiento</td>
                    <td>@mantenimiento.Costo.ToString("c")</td>
                    <td>@mantenimiento.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@mantenimiento.NombreCompletoTecnico - DNI: @mantenimiento.DNITecnico</td>
                    <td>@mantenimiento.Estado</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Editar" asp-route-id="@mantenimiento.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-action="Detalles" asp-route-id="@mantenimiento.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No se adquirieron equipos por el momento.
    </div>
}
