@model IEnumerable<ProveedorViewModel>

@{
	ViewData["Title"] = "Lista de Proveedores";
	var currentSort = ViewData["SortOrder"]?.ToString() ?? "";
}

<h1 class="mb-4">Tus Proveedores</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
	<a asp-action="Create" class="btn btn-primary">
		<i class="bi bi-plus-circle"></i> Nuevo Proveedor
	</a>

	<form method="get" asp-action="Index" class="d-flex align-items-center">
        <label for="sortOrder" class="me-2 fw-bold">Ordenar por:</label>
		<select id="sortOrder" name="sortOrder" class="form-select me-2" onchange="this.form.submit()">
			<option value="">Razón Social (A-Z)</option>
			<option value="monto_desc" selected="@(currentSort == "monto_desc")">Monto (mayor a menor)</option>
			<option value="monto_asc" selected="@(currentSort == "monto_asc")">Monto (menor a mayor)</option>
			<option value="calificacion_desc" selected="@(currentSort == "calificacion_desc")">Calificación (alta a baja)</option>
			<option value="calificacion_asc" selected="@(currentSort == "calificacion_asc")">Calificación (baja a alta)</option>
		</select>
    </form>
</div>


@if (Model != null && Model.Any())
{
	<table class="table table-striped table-bordered align-middle">
		<thead class="table-dark">
			<tr>
				<th>Razón Social</th>
				<th>CUIT</th>
				<th>Monto Total Pagado</th>
				<th>Calificación</th>
				<th>Acciones</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var proveedor in Model)
			{
				<tr>
					<td>@proveedor.RazonSocial</td>
					<td>@proveedor.CUIT</td>
					<td>$@proveedor.MontoTotalPagado.ToString("N2")</td>
					<td>@proveedor.Calificacion</td>
					<td>
						<div class="btn-group" role="group">
							<a asp-action="Edit" asp-route-id="@proveedor.Id" class="btn btn-sm btn-warning">
								<i class="bi bi-pencil"></i> Editar
							</a>
							<a asp-action="Details" asp-route-id="@proveedor.Id" class="btn btn-sm btn-info">
								<i class="bi bi-eye"></i> Detalles
							</a>
							<a asp-action="Delete" asp-route-id="@proveedor.Id" class="btn btn-sm btn-danger"
							   onclick="return confirm('¿Está seguro de eliminar este proveedor?');">
								<i class="bi bi-trash"></i> Eliminar
							</a>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">
		No hay proveedores registrados por el momento.
	</div>
}
