@using Presentacion.Models.Proveedores
@model ProveedorViewModel

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<h2 class="mb-4 text-danger">Eliminar Proveedor</h2>

<h4>¿Está seguro de que desea eliminar este proveedor?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Razón Social</dt>
    <dd class="col-sm-9">@Model.RazonSocial</dd>

    <dt class="col-sm-3">CUIT</dt>
    <dd class="col-sm-9">@Model.CUIT</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">Calificación</dt>
    <dd class="col-sm-9">@Model.Calificacion</dd>
</dl>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
