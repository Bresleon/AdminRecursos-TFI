@using Presentacion.Models.Account
@model RegisterViewModel
@{
    ViewData["Title"] = "Registrar Cuenta";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center">
                <h4>Registrar nueva cuenta</h4>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Register" method="post">

                    <!-- Nombre de usuario -->
                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label">Nombre de usuario</label>
                        <input asp-for="NombreUsuario" class="form-control" />
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label">Contraseña</label>
                        <input asp-for="Contrasena" class="form-control" type="password" />
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>

                    <!-- Confirmación de contraseña -->
                    <div class="mb-3">
                        <label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmarContrasena" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                    </div>

                    <!-- Roles -->
                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label">Rol</label>
                        <select asp-for="Rol" class="form-select">
                            <option value="">Seleccione un rol...</option>
                            <option value="Ejecutivo">Ejecutivo / Administrador</option>
                            <option value="Empleado">Empleado</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-4">
                        Registrar cuenta
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Login">¿Ya tienes una cuenta? Inicia sesión</a>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}