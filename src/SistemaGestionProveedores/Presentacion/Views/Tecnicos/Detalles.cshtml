@model TecnicoViewModel

@{
    ViewData["Title"] = "Detalles del Técnico";
}

<h2 class="mb-4">Detalles del Técnico</h2>

<div class="card shadow-sm p-3">
    <dl class="row">
        <dt class="col-sm-3">Proveedor</dt>
        <dd class="col-sm-9">@Model.ProveedorNombre</dd>

        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

        <dt class="col-sm-3">DNI</dt>
        <dd class="col-sm-9">@Model.DNI</dd>

        <dt class="col-sm-3">Teléfono</dt>
        <dd class="col-sm-9">@Model.Telefono</dd>

        <dt class="col-sm-3">Calificación</dt>
        <dd class="col-sm-9">@Model.Calificacion</dd>
    </dl>
</div>

<div class="mt-4">
    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
