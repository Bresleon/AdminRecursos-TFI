@model TecnicoViewModel

@{
    ViewData["Title"] = "Eliminar Técnico";
}

<h2 class="mb-4 text-danger">Eliminar Técnico</h2>

<h4>¿Está seguro de que desea eliminar este técnico?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.DNI</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">Proveedor</dt>
    <dd class="col-sm-9">@Model.ProveedorNombre</dd>

    <dt class="col-sm-3">Calificación</dt>
    <dd class="col-sm-9">@Model.Calificacion</dd>
</dl>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
