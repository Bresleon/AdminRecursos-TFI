@model TecnicoViewModel

@{
    ViewData["Title"] = "Registrar Técnico";
}

<h2 class="mb-4">Registrar Técnico</h2>

<form asp-action="Crear" method="post">
    <div class="form-group mb-3">
        <label asp-for="ProveedorId" class="form-label">Proveedor</label>
        <select asp-for="ProveedorId" asp-items="Model.ProveedoresDisponibles" class="form-select">
            <option value="">-- Seleccione un proveedor --</option>
        </select>
        <span asp-validation-for="ProveedorId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" placeholder="Ej: Pérez" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DNI" class="form-label"></label>
        <input asp-for="DNI" class="form-control" placeholder="Ej: 40123456" />
        <span asp-validation-for="DNI" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" placeholder="Ej: (011) 5555-4321" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="Calificacion" class="form-label"></label>
        <input asp-for="Calificacion" type="number" step="0.1" min="0" max="5" class="form-control" placeholder="0 - 5" />
        <span asp-validation-for="Calificacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
