@model IEnumerable<TecnicoViewModel>

@{
	ViewData["Title"] = "Lista de Técnicos";
}

<h1 class="mb-4">Tus Técnicos</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
	<a asp-action="Crear" class="btn btn-primary">
		<i class="bi bi-plus-circle"></i> Nuevo Técnico
	</a>

	<form method="get" asp-action="Index" class="d-flex align-items-center">
		<label for="dni" class="me-2 fw-bold">DNI del técnico:</label>
		<input id="dni" name="dni" type="text" class="form-text me-2" />
	</form>
</div>

@if (Model != null && Model.Any())
{
	<table class="table table-striped table-bordered align-middle">
		<thead class="table-dark">
			<tr>
				<th>Nombre Completo</th>
				<th>DNI</th>
				<th>Teléfono</th>
				<th>Proveedor en donde trabaja</th>
				<th>Calificación</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var tecnico in Model)
			{
				<tr>
					<td>@tecnico.Nombre @tecnico.Apellido</td>
					<td>@tecnico.DNI</td>
					<td>@tecnico.Telefono</td>
					<td>@tecnico.ProveedorNombre</td>
					<td>@tecnico.Calificacion</td>
					<td>
						<div class="btn-group" role="group">
							<a asp-action="Editar" asp-route-id="@tecnico.Id" class="btn btn-sm btn-warning">
								<i class="bi bi-pencil"></i> Editar
							</a>
							<a asp-action="Detalles" asp-route-id="@tecnico.Id" class="btn btn-sm btn-info">
								<i class="bi bi-eye"></i> Detalles
							</a>
							<a asp-action="Eliminar" asp-route-id="@tecnico.Id" class="btn btn-sm btn-danger">
								<i class="bi bi-trash"></i> Eliminar
							</a>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	if(ViewData["DNI"] != null)
	{
		<div class="alert alert-info">
			No existe ningún técnico con DNI @ViewData["DNI"].
		</div>
	}
	else
	{
		<div class="alert alert-info">
			No hay técnicos registrados por el momento.
		</div>
	}
}
