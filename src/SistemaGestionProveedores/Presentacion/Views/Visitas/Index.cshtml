@model IEnumerable<Dominio.Entidades.Visita>

@{
    ViewData["Title"] = "Visitas Pendientes";
}

<h1 class="mb-4">Visitas Pendientes</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Visita
    </a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Técnico</th>
                <th>Monto Total</th>
                <th>Calificación</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var visita in Model)
            {
                <tr>
                    <td>@visita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@visita.Tecnico?.Nombre @visita.Tecnico?.Apellido</td>
                    <td>$@visita.MontoTotal.ToString("N2")</td>
                    <td>@visita.Calificacion</td>
                    <td>@visita.Observaciones</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@visita.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@visita.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <a asp-action="Delete" asp-route-id="@visita.Id" class="btn btn-sm btn-danger"
                               onclick="return confirm('¿Está seguro de eliminar esta visita?');">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No hay visitas pendientes por el momento.
    </div>
}
