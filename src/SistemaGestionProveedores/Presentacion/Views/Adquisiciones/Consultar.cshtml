@model AdquisicionViewModel?

@{
    ViewData["Title"] = "Consultar Adquisición";
}

<h2>Consultar Adquisición</h2>

<form asp-action="Consultar" method="post" class="mt-3">
    <div class="form-group">
        <label for="numeroSerie">Número de Serie:</label>
        <input type="text" class="form-control" id="numeroSerie" name="numeroSerie" placeholder="Ingrese el número de serie" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
</form>

@if(Model != null)
{
    <table class="table table-striped table-bordered mt-3">
        <tr>
            <th>Número de Serie</th>
            <td>@Model.NumeroSerie</td>
        </tr>
        <tr>
            <th>Equipo</th>
            <td>@Model.Nombre</td>
        </tr>
        <tr>
            <th>Tipo de Equipo</th>
            <td>@Model.TipoEquipo</td>
        </tr>
        <tr>
            <th>Costo</th>
            <td>@Model.Costo.ToString("c")</td>
        </tr>
        <tr>
            <th>Fecha de Adquisición</th>
            <td>@Model.FechaAdquisicion.ToString("dd/MM/yyyy")</td>
        </tr>
        <tr>
            <th>Fin de Garantía</th>
            <td>@Model.FechaFinGarantia.ToString("dd/MM/yyyy")</td>
        </tr>
        <tr>
            <th>Técnico que lo vendió</th>
            <td>@($"{Model.NombreCompletoTecnico} - DNI: {Model.DNITecnico}")</td>
        </tr>
    </table>
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning mt-3">@ViewBag.Mensaje</div>
}
