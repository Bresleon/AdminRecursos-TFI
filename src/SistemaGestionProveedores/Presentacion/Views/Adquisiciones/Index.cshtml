@using Presentacion.Models.Adquisiciones
@model IEnumerable<AdquisicionViewModel>

@{
    ViewData["Title"] = "Lista de adquisiciones";
}

<h1 class="mb-4">Tus adquisiciones</h1>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Adquisición
    </a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Número de Serie</th>
                <th>Equipo</th>
                <th>Tipo de Equipo</th>
                <th>Costo</th>
                <th>Adquirido el día</th>
                <th>Técnico vendedor</th>
                <th>Fin de garantía</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var adquisicion in Model)
            {
                <tr>
					<td>@adquisicion.NumeroSerie</td>
					<td>@adquisicion.Nombre</td>
					<td>@adquisicion.TipoEquipo</td>
					<td>@adquisicion.Costo.ToString("c")</td>
                    <td>@adquisicion.FechaAdquisicion.ToString("dd/MM/yyyy")</td>
                    <td>@adquisicion.NombreCompletoTecnico - DNI: @adquisicion.DNITecnico</td>
                    <td>@adquisicion.FechaFinGarantia.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Editar" asp-route-id="@adquisicion.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No se adquirieron equipos por el momento.
    </div>
}
