@model AdquisicionUpsertViewModel

@{
    ViewData["Title"] = "Editar Adquisición";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post" class="card p-4 shadow-sm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TecnicoId" />

    <div class="alert alert-info">
        <strong>Técnico:</strong> @Model.NombreCompletoTecnico <br />
        <strong>Proveedor:</strong> @Model.NombreProveedor
    </div>

    <div class="mb-3">
        <label class="form-label">Equipo</label>
        <select asp-for="EquipoId" class="form-select" asp-items="Model.EquiposDisponibles"></select>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroSerie" class="form-label"></label>
        <input asp-for="NumeroSerie" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaAdquisicion" class="form-label"></label>
        <input asp-for="FechaAdquisicion" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaFinGarantia" class="form-label"></label>
        <input asp-for="FechaFinGarantia" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Costo" class="form-label"></label>
        <input asp-for="Costo" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
