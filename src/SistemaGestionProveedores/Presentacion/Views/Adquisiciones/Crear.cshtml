@using Presentacion.Models.Adquisiciones
@model AdquisicionUpsertViewModel

@{
    ViewData["Title"] = "Registrar Adquisición";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Crear" method="post" id="adquisicionForm" class="card p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">DNI del Técnico</label>
        <div class="input-group">
            <input type="text" id="dniTecnico" class="form-control" placeholder="Ingrese DNI del técnico" />
            <button type="button" class="btn btn-outline-primary" id="buscarTecnicoBtn">Buscar</button>
        </div>
        <small class="text-muted">Debe buscar el técnico para continuar.</small>
    </div>

    <div id="tecnicoInfo" class="alert alert-info d-none">
        <strong>Técnico encontrado:</strong>
        <p id="tecnicoNombre"></p>
        <p id="proveedorNombre"></p>
    </div>

    <div id="camposAdquisicion" class="d-none">
        <div class="mb-3">
            <label class="form-label">Equipo</label>
            <select asp-for="EquipoId" class="form-select" id="equipoSelect">
                <option value="">Seleccione un equipo...</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="NumeroSerie" class="form-label"></label>
            <input asp-for="NumeroSerie" class="form-control" />
            <span asp-validation-for="NumeroSerie" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FechaAdquisicion" class="form-label"></label>
            <input asp-for="FechaAdquisicion" type="date" class="form-control" />
            <span asp-validation-for="FechaAdquisicion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FechaFinGarantia" class="form-label"></label>
            <input asp-for="FechaFinGarantia" type="date" class="form-control" />
            <span asp-validation-for="FechaFinGarantia" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Costo" class="form-label"></label>
            <input asp-for="Costo" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Costo" class="text-danger"></span>
        </div>

        <input type="hidden" asp-for="TecnicoId" id="tecnicoId" />

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("buscarTecnicoBtn").addEventListener("click", function () {
            const dni = document.getElementById("dniTecnico").value.trim();
            if (!dni) {
                alert("Ingrese un DNI para buscar el técnico.");
                return;
            }

            fetch(`/Tecnicos/BuscarTecnicoPorDni?dni=${dni}`)
                .then(res => {
                    if (!res.ok) throw new Error("Error en la búsqueda");
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.tecnico) {
                        alert("No se encontró ningún técnico con ese DNI.");
                        return;
                    }

                    // Mostrar datos del técnico
                    document.getElementById("tecnicoInfo").classList.remove("d-none");
                    document.getElementById("tecnicoNombre").innerText = `Nombre: ${data.tecnico.nombre} ${data.tecnico.apellido}`;
                    document.getElementById("proveedorNombre").innerText = `Proveedor: ${data.tecnico.proveedor}`;
                    document.getElementById("tecnicoId").value = data.tecnico.id;

                    // Mostrar formulario
                    document.getElementById("camposAdquisicion").classList.remove("d-none");

                    // Llenar catálogo de equipos
                    const selectEquipo = document.getElementById("equipoSelect");
                    selectEquipo.innerHTML = '<option value="">Seleccione un equipo...</option>';
                    data.equipos.forEach(eq => {
                        const opt = document.createElement("option");
                        opt.value = eq.id;
                        opt.textContent = eq.nombre;
                        selectEquipo.appendChild(opt);
                    });
                })
                .catch(err => {
                    console.error(err);
                    alert("Ocurrió un error al buscar el técnico.");
                });
        });
    </script>
}
